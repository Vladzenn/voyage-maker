  "Primary Aptitude": {
    "name": "Primary Aptitude",
    "maxSelections": 1,
    "traits": [
      "Primary Force",
      "Primary Finesse",
      "Primary Logic",
      "Primary Passion",
      "Primary Empathy",
      "Primary Intuition"
    ],
    "description": "Choose your strongest aptitude: +5, normally 15 from base 10. Force covers physical power, resilience, and guarded fighting; Finesse covers coordination, precision, and timing. Logic, Passion, Empathy, and Intuition support the listed magical disciplines. This is capability, not a personality or class. The choice also supplies common foundational skills at level 0."
  },
  "Secondary Aptitude": {
    "name": "Secondary Aptitude",
    "maxSelections": 1,
    "traits": [
      "Secondary Force",
      "Secondary Finesse",
      "Secondary Logic",
      "Secondary Passion",
      "Secondary Empathy",
      "Secondary Intuition"
    ],
    "description": "Choose a different supporting aptitude: +3, normally 13. A spellblade can pair a physical and magical aptitude; a dedicated caster can pair two magical aptitudes. Other attributes remain 10. A matching primary is excluded. No attribute is required for the basic Health, Mana or Stamina pool."
  },
